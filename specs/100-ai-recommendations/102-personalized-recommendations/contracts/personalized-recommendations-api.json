    },
    "/recommendations/songs": {
      "get": {
        "summary": "Retrieve Recommended Songs (Backward-Compatible Alias)",
        "description": "Convenience alias for client modules requesting only song entities. Equivalent to calling `/recommendations/personalized?type=song`.",
        "operationId": "getRecommendedSongs",
        "tags": [
          "Recommendations"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recommended songs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationApiResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/paths/~1recommendations~1personalized/get/responses/401"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pass active user JWT token: Bearer <access_token>"
      }
    },
    "schemas": {
      "RecommendationApiResponse": {
        "type": "object",
        "required": ["success", "data", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": "Danh sách gợi ý cá nhân hóa"
          },
          "data": {
            "$ref": "#/components/schemas/RecommendationFeedResult"
          },
          "error": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        }
      },
      "RecommendationFeedResult": {
        "type": "object",
        "required": ["user_id", "is_fallback", "generated_at", "total_items", "items"],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "4a7372cf-6c2e-4b47-9f7e-7c4273215891"
          },
          "is_fallback": {
            "type": "boolean",
            "description": "True if output is cold-start or degraded trending content rather than deep personal vector recommendations.",
            "example": false
          },
          "fallback_reason": {
            "type": "string",
            "nullable": true,
            "enum": [null, "COLD_START", "INSUFFICIENT_HISTORY", "HISTORY_PURGED", "AI_SERVICE_UNAVAILABLE"],
            "example": null
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-03T18:30:00.000Z"
          },
          "total_items": {
            "type": "integer",
            "example": 4
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendedItem"
            }
          }
        }
      },
      "RecommendedItem": {
        "type": "object",
        "required": ["id", "type", "title", "subtitle", "badge", "target_id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e0a1b2c3-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
          },
          "type": {
            "type": "string",
            "enum": ["song", "album", "artist", "playlist"],
            "example": "song"
          },
          "title": {
            "type": "string",
            "example": "Nàng Thơ"
          },
          "subtitle": {
            "type": "string",
            "example": "Hoàng Dũng"
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "example": "https://storage.auratune.vn/covers/nang-tho.jpg"
          },
          "badge": {
            "type": "string",
            "example": "Gợi ý"
          },
          "target_id": {
            "type": "string",
            "format": "uuid",
            "example": "e0a1b2c3-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
          },
          "extra": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "duration": 254,
              "audio_url": "/api/v1/songs/e0a1b2c3-4d5e-6f7a-8b9c-0d1e2f3a4b5c/stream"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "message", "data", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Yêu cầu đăng nhập để nhận gợi ý cá nhân hóa"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "error": {
            "type": "object",
            "required": ["code", "details"],
            "properties": {
              "code": {
                "type": "string",
                "example": "UNAUTHORIZED"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": []
              }
            }
          }
        }
      }
    }
  }
}
