{
  "openapi": "3.0.3",
  "info": {
    "title": "AuraTune Personalized Recommendations API (Feature 102)",
    "version": "1.0.0",
    "description": "API contract for personalized multi-entity music recommendations, cold-start fallbacks, and resilient service degradation under Group 100 – AI Recommendations."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.auratune.internal/api/v1",
      "description": "Staging / Internal Environment"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/recommendations/personalized": {
      "get": {
        "summary": "Retrieve Personalized Recommendations Feed",
        "description": "Returns a personalized list of recommended items (songs, albums, artists, playlists) tailored to the authenticated listener's history and preferences. Degrades gracefully to popular content during cold-start or AI service outage.",
        "operationId": "getPersonalizedRecommendations",
        "tags": [
          "Recommendations"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter recommendations by entity type.",
            "schema": {
              "type": "string",
              "enum": ["all", "song", "album", "artist", "playlist"],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of recommendation items to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Personalized recommendation feed retrieved successfully (or served via graceful fallback).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationApiResponse"
                },
                "examples": {
