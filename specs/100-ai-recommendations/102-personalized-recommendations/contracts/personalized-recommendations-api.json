            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Yêu cầu đăng nhập để nhận gợi ý cá nhân hóa",
                  "data": null,
                  "error": {
                    "code": "UNAUTHORIZED",
                    "details": []
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Account disabled or banned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Tài khoản của bạn đã bị khóa",
                  "data": null,
                  "error": {
                    "code": "ACCOUNT_BANNED",
                    "details": []
