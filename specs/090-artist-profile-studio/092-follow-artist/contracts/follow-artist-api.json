    "/users/me/following-artists": {
      "get": {
        "operationId": "getOwnFollowingArtists",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Current signed AuraTune JWT user_id and session_id; current nonbanned user/artist/admin only. No owner/body/time/idempotency selector. Database rechecks session and eligibility in operation transaction. No anonymous or cross-owner access.",
        "parameters": [
          {
            "name": "artistId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9]\\d{0,18})$",
              "description": "Canonical signed int64 decimal string, checked within PostgreSQL bigint bounds; never JSON number."
            },
            "description": "Optional public target for safe recognition in the SAME snapshot as complete list. Nonpublic/unknown returns generic 404. No hidden status projection."
          }
        ],
        "responses": {
          "200": {
            "description": "Complete own list",
            "headers": {
