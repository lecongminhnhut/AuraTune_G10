                      "required": [
                        "complete",
                        "artists"
                      ],
                      "properties": {
                        "complete": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "artists": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "name",
                              "imageUrl",
                              "followedAt"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^(?:0|-?[1-9]\\d{0,18})$",
                                "description": "Canonical signed int64 decimal string, checked within PostgreSQL bigint bounds; never JSON number."
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "imageUrl": {
                                "type": "string",
                                "nullable": true
                              },
                              "followedAt": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Original database created_at, full precision. Duplicate follow never resets it."
                              }
                            }
                          },
                          "description": "Every eligible own artist ordered by created_at DESC then bigint artist_id ASC; no hidden totals or placeholders."
                        }
                      }
