              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^(0|-?[1-9][0-9]{0,18})$",
                          "description": "Canonical signed int64 decimal; server verifies bounds; never JavaScript number."
                        },
                        "name": {
                          "type": "string"
                        },
                        "imageUrl": {
                          "type": "string",
                          "nullable": true
                        },
                        "profileVisibility": {
                          "type": "string",
                          "enum": [
                            "public",
                            "hidden",
                            "unreviewed"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "imageUrl",
                        "profileVisibility"
                      ]
                    },
                    "error": {
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data",
                    "error"
                  ]
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
