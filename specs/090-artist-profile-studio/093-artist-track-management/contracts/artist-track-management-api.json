    "/studio/me": {
      "get": {
        "summary": "Current linked Artist identity, including hidden profiles.",
        "description": "No query parameters or request body. Identity is resolved from current authenticated principal, never from a browser artist selector.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmed read; each section can fail independently. Cache-Control: private, no-store.",
