{
  "name": "auratune-backend",
  "version": "1.0.0",
  "description": "AuraTune Node.js/Express Backend Server for Feature 010 (Authentication & Session Management)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\" \"tests/*.test.js\"",
    "test:vitest": "vitest run",
    "test:artist-profile": "node --test tests/artist-profile-identity.test.js",
    "test:artist-migrations": "node --test ../database/tests/artistVisibilityMigration.test.mjs",
    "test:follow": "node --test tests/follow-auth.test.js tests/follow-persistence.test.js tests/follow-migration.test.js",
    "test:follow:concurrency": "test -n \"$FOLLOW_PG_CONTAINER\" && node --test tests/follow-concurrency.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "auratune": "file:../..",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^22.3.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
